# Copy to .env and fill in.
WANDERER_ENV=dev
WANDERER_LOG_LEVEL=INFO
WANDERER_DATABASE_URL=postgresql+asyncpg://wanderer:wanderer@localhost:5432/wanderer
WANDERER_REDIS_URL=redis://localhost:6379/0

# Firebase project + service account JSON for token verification.
# Leave FIREBASE_CREDENTIALS_PATH empty in dev to use ADC.
WANDERER_FIREBASE_PROJECT_ID=
WANDERER_FIREBASE_CREDENTIALS_PATH=

WANDERER_PLAY_BILLING_PACKAGE_NAME=app.wanderer
WANDERER_CORS_ORIGINS=*
